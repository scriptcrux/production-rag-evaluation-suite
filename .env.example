# FinSight Enterprise AI Configuration

# LLM Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0
MAX_OUTPUT_TOKENS=1500

# RAG & Retrieval Settings
HYBRID_ALPHA=0.5
DENSE_TOP_K=10
SPARSE_TOP_K=10
RERANK_TOP_K=4
RRF_K=60

# Conversation Memory
MAX_MEMORY_TURNS=5
SESSION_TIMEOUT_MINUTES=60

# DeepEval CI/CD Evaluation Thresholds
CONFIDENT_AI_API_KEY=your-confident-ai-key-optional
DEEPEVAL_EVAL_MODEL=gpt-4o-mini
THRESHOLD_FAITHFULNESS=0.85
THRESHOLD_ANSWER_RELEVANCY=0.70
THRESHOLD_CONTEXTUAL_PRECISION=0.70
THRESHOLD_CONTEXTUAL_RECALL=0.80
THRESHOLD_HALLUCINATION=0.15

# Telemetry & Cost Limits
MAX_LATENCY_SECONDS=4.0
MAX_QUERY_COST_USD=0.03
